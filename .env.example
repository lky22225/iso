# 로컬: docker compose up -d 후 아래 URL을 .env.local 로 복사하세요.
# @vercel/postgres 는 Vercel 환경의 POSTGRES_URL 과 동일한 변수를 사용합니다.
POSTGRES_URL=postgresql://iso:iso@localhost:5432/iso

# 프로덕션 도메인 (sitemap·robots의 Sitemap URL). Vercel: Environment Variables에 설정 권장
# NEXT_PUBLIC_SITE_URL=https://www.example.com
# 관리자 API (/api/admin/*). 미설정 시 기본값 iso_admin (개발 전용).
# ADMIN_PASSWORD=

# 웹 문의 알림 메일 (기본 비활성). 켤 때: INQUIRY_EMAIL_ENABLED=true + 아래 SMTP
# INQUIRY_EMAIL_ENABLED=false
#
# Gmail 예: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
# 앱 비밀번호: Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호
# SMTP_FROM="ISO 인증 파트너 <isopartner5446@gmail.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# (선택) 알림 수신 주소를 바꿀 때만. 기본: isopartner5446@gmail.com
# INQUIRY_NOTIFY_TO=
